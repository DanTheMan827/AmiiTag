<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows: a single self-contained AmiiTag.exe (no MSIX, no installer, nothing else to install apart from the
  WebView2 runtime that Windows 10/11 already have).

    dotnet publish AmiiTag.Maui -f net10.0-windows10.0.19041.0 -p:PublishProfile=win-x64

  or Publish in Visual Studio with this profile. The exe ends up in AmiiTag.Maui\bin\publish\win-x64\.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>

  <!--
    Only for the Windows target: restore evaluates every target framework of the project, and a Windows runtime
    identifier on the Android/iOS/Mac ones makes it look for a Mono runtime pack for Windows, which doesn't exist.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Unpackaged and self-contained: .NET and the Windows App SDK travel inside the exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- One file. The web assets (wwwroot), WinUI resources and native libraries are extracted on first run. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Blazor and the BLE/NFC libraries use reflection; trimming isn't safe for them. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
