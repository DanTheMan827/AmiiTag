@code {
	private const string blackFill = "fill: #000";
	private const string whiteFill = "fill: #fff";

	private string TextStyle { 
		get
		{
			switch (TextColor)
			{
				case TextFill.Black:
					return blackFill;

				case TextFill.White:
					return whiteFill;
			}

			return "";
		}
	}

	public enum TextFill { 
		/// <summary>
		/// Automatic selection based on the interface color.
		/// </summary>
		Auto,

		/// <summary>
		/// White text for use on a dark background.
		/// </summary>
		White, 

		/// <summary>
		/// Black text for use on a light background.
		/// </summary>
		Black 
	}

	/// <summary>
	/// Determines the color of the logo text
	/// </summary>
	[Parameter]
	public TextFill TextColor { get; set; } = TextFill.Auto;

	/// <summary>
	/// A unique component ID.
	/// </summary>
	[Parameter()]
	public string Id { get; set; } = Guid.NewGuid().ToString();

	/// <summary>
	/// Additional CSS styles.
	/// </summary>
	[Parameter]
	public string Style { get; set; } = "";

	/// <summary>
	/// Additional SVG classes.
	/// </summary>
	[Parameter]
	public string Class { get; set; } = "";
}