@page "/"
@using AmiiTag.Simulation
@inject IAppNavigator Navigator
@inject TagActions Actions
@inject AppState State
@inject IDialogService Dialogs
@inject DeviceCapabilities Capabilities
@inject NfcService Nfc
@inject HomeScreenState Screen
@inject FlipperEmulationService Flipper
@inject N2EliteService N2
@implements IDisposable

@* Dropped files are recognised by their contents: keys, amiibo, lock-ons, UID/signature pairs. *@
<AppPage Title="AmiiTag" ShowHeader="false" ShowBack="false" Sheet="false" Class="home"
         OnFilesDropped="Actions.HandleDroppedFilesAsync" DropLabel="Drop amiibo, keys, lock-ons or UID/signature pairs">
    <button type="button" class="logo-button" @onclick="LogoTapped" aria-label="Database and key options">
        <AppLogo Class="home-logo" />
    </button>

    <div class="button-stack">
        <BigButton OnClick="OpenLibrary">Amiibo Library</BigButton>
        <BigButton OnClick="OpenGames">Game Info</BigButton>
        @* Scanning and writing need NFC here: the phone's own, or (web) a reader over Web Serial. Bluetooth devices
           are read and written from their own pages. *@
        @if (Capabilities.HasNfc)
        {
            <BigButton OnClick="Actions.ScanTagAsync">Scan Tag</BigButton>
        }
        <BigButton OnClick="Actions.LoadTagFromFileAsync">Load Tag</BigButton>
        <BigButton OnClick="OpenLockOns">Lock-on Library</BigButton>

        @if (Capabilities.HasCamera)
        {
            <BigButton OnClick="Actions.ScanQrAsync">Scan QR Code</BigButton>
        }
        @if (Capabilities.HasNfc)
        {
            <BigButton OnClick="OpenN2Elite">Manage N2 Elite</BigButton>
        }
        @* In Safari on iPhone/iPad without Web Bluetooth it's still shown: it explains how Beacio adds it. *@
        @if (Capabilities.HasBluetooth || Capabilities.Messages.SuggestsBeacio)
        {
            <BigButton OnClick="OpenDevices">Connect Bluetooth Device</BigButton>
        }
        @if (Flipper.IsAvailable)
        {
            <BigButton OnClick="EmulateN2">Emulate N2</BigButton>
        }
        <BigButton OnClick="OpenSettings" Class="secondary">Settings</BigButton>
    </div>
</AppPage>

@code {
    private CancellationTokenSource? _monitorCallbacks;
    private bool _disposed;

    protected override void OnInitialized()
    {
        Flipper.Changed += async (_,_) => await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Capabilities.Changed += OnCapabilitiesChanged;
            Screen.Changed += OnScreenChanged;
            Screen.SetVisible(true);
            await Capabilities.RefreshAsync();
            await State.EnsureStartedAsync();
            UpdateMonitoring();
        }
    }

    private void OnCapabilitiesChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnScreenChanged(object? sender, EventArgs e) => InvokeAsync(UpdateMonitoring);

    /// <summary>
    /// While the main menu is in front and a reader works here, an amiibo placed on the reader is opened straight away.
    /// </summary>
    private void UpdateMonitoring()
    {
        if (!_disposed && Screen.IsVisible && Capabilities.HasNfc)
        {
            _monitorCallbacks ??= new CancellationTokenSource();
            var token = _monitorCallbacks.Token;
            Nfc.StartMonitoring(image => InvokeAsync(() => Actions.ShowScannedTagAsync(image, automatic: true, cancellationToken: token)));
        }
        else
        {
            CancelMonitorCallbacks();
            _ = Nfc.StopMonitoringAsync();
        }
    }

    private void CancelMonitorCallbacks()
    {
        _monitorCallbacks?.Cancel();
        _monitorCallbacks?.Dispose();
        _monitorCallbacks = null;
    }

    public void Dispose()
    {
        _disposed = true;
        CancelMonitorCallbacks();
        Capabilities.Changed -= OnCapabilitiesChanged;
        Screen.Changed -= OnScreenChanged;
        Screen.SetVisible(false);
        _ = Nfc.StopMonitoringAsync();
    }

    private Task OpenLibrary() => Navigator.NavigateAsync(AppRoutes.Library());

    private Task OpenGames() => Navigator.NavigateAsync(AppRoutes.Games());

    private Task OpenLockOns() => Navigator.NavigateAsync(AppRoutes.LockOns());

    // In a browser this opens its device picker straight away (it needs this click as the user gesture).
    private Task OpenDevices() => Actions.OpenBluetoothDevicesAsync();

    // A full scan every time (unlocking the N2 if needed); the screen opens once an N2 has been read.
    private async Task OpenN2Elite()
    {
        if (await N2.ScanAsync())
        {
            await Navigator.NavigateAsync(AppRoutes.N2Elite());
        }
    }
    private Task EmulateN2() => Flipper.EmulateAsync(new N2EliteSimulator(){IsLocked = true}, "N2 Emulation");

    private Task OpenSettings() => Navigator.NavigateAsync(AppRoutes.Settings());

    /// <summary>
    /// Tapping the logo offers the same shortcuts as the Swift app.
    /// </summary>
    private async Task LogoTapped()
    {
        var choice = await Dialogs.ChooseAsync("AmiiTag", ["Update Database", "Settings"]);
        switch (choice)
        {
            case 0:
                await State.UpdateDatabaseAsync();
                break;
            case 1:
                await OpenSettings();
                break;
        }
    }
}
