<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>AmiiTag.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Composite" Version="10.0.15" />
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmiiTag.Tags\AmiiTag.Tags.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc\AmiiTag.Nfc.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.PcSc\AmiiTag.Nfc.PcSc.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.Mfrc522\AmiiTag.Nfc.Mfrc522.csproj" />
    <ProjectReference Include="..\AmiiTag.Bluetooth\AmiiTag.Bluetooth.csproj" />
    <ProjectReference Include="..\AmiiTag.Simulation\AmiiTag.Simulation.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.Flipper\AmiiTag.Nfc.Flipper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AmiiTag.Maui\Services\SyncedFigureImageFiles.cs" Link="SyncedFigureImageFiles.cs" />
    <!-- Exercise the browser serial adapter with the real JSInterop API without loading a WASM host. -->
    <Compile Include="..\AmiiTag.WebAssembly\Services\WebSerialPortStream.cs" Link="WebSerialPortStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AmiiTag.Simulation" />
  </ItemGroup>

</Project>
