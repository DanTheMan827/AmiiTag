<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console relay: a Flipper Zero running the NFC Bridge app emulates the tag that's on a serial NFC reader
       (MFRC522 or PN532, detected like the app does), every frame from the Flipper's reader goes to the real tag, and
       the traffic is logged. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AmiiTag.NfcRelay</RootNamespace>
    <AssemblyName>amiitag-nfc-relay</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmiiTag.Nfc\AmiiTag.Nfc.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.Mfrc522\AmiiTag.Nfc.Mfrc522.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.Pn532\AmiiTag.Nfc.Pn532.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.Flipper\AmiiTag.Nfc.Flipper.csproj" />
    <ProjectReference Include="..\AmiiTag.Licenses\AmiiTag.Licenses.csproj" />
  </ItemGroup>

</Project>
