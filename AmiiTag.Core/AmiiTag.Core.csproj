<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <!-- Pure managed QR encoder (PNG output works in the browser and in MAUI). -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmiiTag.AmiiboData\AmiiTag.AmiiboData.csproj" />
    <ProjectReference Include="..\AmiiTag.Tags\AmiiTag.Tags.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc\AmiiTag.Nfc.csproj" />
    <ProjectReference Include="..\AmiiTag.Bluetooth\AmiiTag.Bluetooth.csproj" />
    <ProjectReference Include="..\AmiiTag.Nfc.Flipper\AmiiTag.Nfc.Flipper.csproj" />
    <ProjectReference Include="..\libamiibo\libamiibo\libamiibo.csproj" />
  </ItemGroup>

</Project>
