@* Page chrome. MAUI uses the native navigation bar (so no header here). The web draws this header, and only shows
   Back when installed as an app on iPhone/iPad, the one place without a browser or system back control. *@
@inject AppEnvironment Environment
@inject IAppNavigator Navigator
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@implements IAsyncDisposable

@if (IsWeb)
{
    <PageTitle>@(string.IsNullOrEmpty(Title) ? "AmiiTag" : $"{Title} - AmiiTag")</PageTitle>
}

@* The page itself is a drop zone when the screen takes dropped files (OnFilesDropped). *@
<DropZone Class="@($"app-page {(Sheet ? "sheet" : "")} {(Wide ? "wide" : "")} {Class}")"
          Enabled="DropEnabled" Label="@DropLabel" OnFiles="OnFilesDropped">
    @if (DrawsHeader && (ShowHeader || OnSettings.HasDelegate))
    {
        <header class="page-header" @ref="_headerElement">
            <div class="page-header-side">
                @if (BackVisible)
                {
                    <button type="button" class="link-button" @onclick="GoBack" aria-label="Back">&#x2039; Back</button>
                }
            </div>
            <h1 class="page-title">@Title</h1>
            <div class="page-header-side end">
                @HeaderActions
                @if (OnSettings.HasDelegate) { <SettingsGear OnClick="OnSettings" /> }
            </div>
        </header>
    }
    else if (!DrawsHeader && HeaderActions != null)
    {
        <div class="page-actions">@HeaderActions</div>
    }

    <main class="page-content">
        @ChildContent
        @if (!IsWeb && Chrome == null && OnSettings.HasDelegate)
        {
            <div class="page-actions"><SettingsGear OnClick="OnSettings" /></div>
        }
    </main>
</DropZone>

<ContextMenuOverlay />
@if (OnRefresh.HasDelegate) { <PageRefreshAction OnRefresh="OnRefresh" /> }

@code {
    // Whether the web app runs as an installed app on iOS. Evaluated once per session.
    private static bool? s_iosStandalone;

    [CascadingParameter] public PageChromeState? Chrome { get; set; }
    [Parameter] public EventCallback OnSettings { get; set; }
    [Parameter] public Func<Task<bool>>? TryBack { get; set; }
    [Parameter] public bool CanGoBack { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    private PageChromeState? _registeredChrome;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_registeredChrome, Chrome)) _registeredChrome?.Remove(this);
        _registeredChrome = Chrome;
        if (IsWeb && TryBack != null && _navigationGuard == null)
            _navigationGuard = Navigation.RegisterLocationChangingHandler(BeforeHistoryNavigation);
        Chrome?.SetBack(this, CanGoBack && TryBack != null ? TryBackOnRenderer : null);
        Chrome?.SetSettings(this, OnSettings.HasDelegate ? () => InvokeAsync(() => OnSettings.InvokeAsync()) : null);
    }

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowBack { get; set; } = true;

    /// <summary>
    /// Web: show Back even where the browser has its own, for screens the browser's Back can't return from properly.
    /// </summary>
    [Parameter] public bool ForceBack { get; set; }

    /// <summary>
    /// Replaces the default Back behaviour (one step back in history).
    /// </summary>
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>
    /// Uses the dark "sheet" background (library, tag info...) rather than the black home background.
    /// </summary>
    [Parameter] public bool Sheet { get; set; } = true;

    /// <summary>
    /// Lets the content use more width on large screens (grids, two column layouts).
    /// </summary>
    [Parameter] public bool Wide { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Files dropped anywhere on the page that an inner drop zone (a slot, a folder) doesn't take.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<PickedFile>> OnFilesDropped { get; set; }

    /// <summary>
    /// What a drop on the page does, shown while files are over it.
    /// </summary>
    [Parameter] public string? DropLabel { get; set; }

    /// <summary>
    /// Turns the page's drop zone off without removing <see cref="OnFilesDropped"/> (say while nothing can take it).
    /// </summary>
    [Parameter] public bool DropEnabled { get; set; } = true;

    private bool IsWeb => Environment.Platform == AppEnvironment.PlatformType.WebAssembly;

    /// <summary>
    /// Only the web lacks a native navigation bar.
    /// </summary>
    private bool DrawsHeader => IsWeb;

    private bool BackVisible => IsWeb && (CanGoBack || ForceBack || (ShowBack && s_iosStandalone == true));

    // Desktop app: the mouse's back button goes back (the web has the browser's own handling).
    private IJSObjectReference? _mouseBack;
    private IDisposable? _navigationGuard;
    private int _tryingBack;
    private IJSObjectReference? _headerSize;
    private ElementReference _headerElement;
    private bool _measuringHeader;
    private bool _disposed;
    private IJSObjectReference? _pullGuard;
    private DotNetObjectReference<AppPage>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) Chrome?.NotifyContentReady();
        if (IsWeb && (ShowHeader || OnSettings.HasDelegate) && _headerSize == null && !_measuringHeader)
        {
            _measuringHeader = true;
            try
            {
                await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AmiiTag.Core/js/header-size.js");
                if (_disposed) return;
                var measurement = await module.InvokeAsync<IJSObjectReference>("register", _headerElement);
                if (_disposed && measurement != null)
                {
                    await measurement.InvokeVoidAsync("dispose");
                    await measurement.DisposeAsync();
                }
                else _headerSize = measurement;
            }
            catch (JSException) { }
            finally { _measuringHeader = false; }
        }
        if (firstRender && !IsWeb)
        {
            try
            {
                _self = DotNetObjectReference.Create(this);
                await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AmiiTag.Core/js/mouse-back.js");
                _mouseBack = await module.InvokeAsync<IJSObjectReference>("register", _self);
                if (Chrome?.SupportsPullToRefresh == true)
                {
                    await using var guard = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AmiiTag.Core/js/native-pull-guard.js");
                    _pullGuard = await guard.InvokeAsync<IJSObjectReference>("register", _self);
                }
            }
            catch (JSException)
            {
                // No scripts here: the native back controls still work.
            }
        }

        if (firstRender && IsWeb && s_iosStandalone == null)
        {
            try
            {
                s_iosStandalone = await JS.InvokeAsync<bool>("amiitag.isIosStandalone");
            }
            catch (JSException)
            {
                s_iosStandalone = false;
            }

            if (s_iosStandalone == true)
            {
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public Task SetPullBlocked(bool blocked) => InvokeAsync(() => Chrome?.SetPullBlocked(blocked));

    [JSInvokable]
    public Task MouseBack() => InvokeAsync(GoBack);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _registeredChrome?.Remove(this);
        _navigationGuard?.Dispose();
        try
        {
            if (_headerSize != null)
            {
                await _headerSize.InvokeVoidAsync("dispose");
                await _headerSize.DisposeAsync();
            }
            if (_pullGuard != null)
            {
                await _pullGuard.InvokeVoidAsync("dispose");
                await _pullGuard.DisposeAsync();
            }
            if (_mouseBack != null)
            {
                await _mouseBack.InvokeVoidAsync("dispose");
                await _mouseBack.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page's web view is already gone.
        }
        catch (JSException)
        {
        }

        _self?.Dispose();
    }

    private ValueTask BeforeHistoryNavigation(LocationChangingContext context)
    {
        if (_disposed || !CanGoBack || context.IsNavigationIntercepted ||
            context.CancellationToken.IsCancellationRequested ||
            Navigator is AmiiTag.Core.Services.Web.BrowserNavigator browser && browser.IsAppNavigation(context))
            return ValueTask.CompletedTask;
        context.PreventNavigation();
        // Finish the navigation decision immediately. BLE reads must not keep
        // Blazor's browser-history rollback pending across another Back press.
        _ = InvokeAsync(BackFromHistoryAsync);
        return ValueTask.CompletedTask;
    }

    private async Task BackFromHistoryAsync()
    {
        try { await TryBackOnRenderer(); }
        catch (Exception ex) { await Dialogs.AlertAsync("Couldn't open folder", ex.Message); }
    }

    private async Task<bool> TryBackOnRenderer()
    {
        if (Interlocked.CompareExchange(ref _tryingBack, 1, 0) != 0) return true;
        try
        {
            var handled = false;
            await InvokeAsync(async () => handled = TryBack != null && await TryBack());
            return handled;
        }
        finally { Interlocked.Exchange(ref _tryingBack, 0); }
    }

    private async Task GoBack()
    {
        if (await TryBackOnRenderer()) return;
        if (OnBack.HasDelegate) await OnBack.InvokeAsync();
        else await Navigator.GoBackAsync();
    }
}
