@inject IFigureImageProvider Images

@if (_url != null && !_failed)
{
    @* A missing image (e.g. not on the server yet) falls back to the placeholder. *@
    <img src="@_url" alt="@Figure?.Name" class="@Class" loading="lazy" @onerror="() => _failed = true" />
}
else
{
    <div class="@Class image-placeholder" aria-hidden="true"></div>
}

@code {
    private string? _url;
    private bool _failed;
    private AmiiboFigure? _loadedFor;

    [Parameter] public AmiiboFigure? Figure { get; set; }
    [Parameter] public string? Class { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(_loadedFor, Figure))
        {
            return;
        }

        var figure = Figure;
        _loadedFor = figure;
        _url = null;
        _failed = false;
        if (figure != null)
        {
            string? url;
            try { url = await Images.GetImageUrlAsync(figure); }
            catch { url = null; }
            // An IndexedDB fetch may finish after this component is reused for
            // another figure. A stale completion must not replace its image.
            if (ReferenceEquals(_loadedFor, figure)) _url = url;
        }
    }
}
