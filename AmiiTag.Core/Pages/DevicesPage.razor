@page "/devices"
@implements IAsyncDisposable
@inject BleDeviceManager Manager
@inject IAppNavigator Navigator
@inject IDialogService Dialogs

<AppPage Title="Devices">
    @if (!Manager.Adapter.IsAvailable)
    {
        <p class="empty-state">Bluetooth isn't available here. In a browser, use Chrome or Edge (WebBluetooth) on desktop or Android.</p>
    }
    else
    {
        @if (_problem != null)
        {
            <p class="notice">@_problem</p>
        }

        @if (Manager.Adapter.CanRequestDevice)
        {
            <div class="button-stack compact">
                <BigButton OnClick="RequestDevice">Pair a Device</BigButton>
            </div>
        }

        @if (Manager.Connected.Count > 0)
        {
            <h2 class="section-title">Connected</h2>
            <ul class="list">
                @foreach (var device in Manager.Connected)
                {
                    <li>
                        <button type="button" class="list-row" @onclick="() => OpenDevice(device)">
                            <span class="list-row-title">
                                @device.Name
                                <span class="list-row-subtitle">@TagDeviceDetector.Describe(device.Kind)@(device.Firmware != null ? $" · {device.Firmware}" : "")</span>
                            </span>
                            <span class="chevron" aria-hidden="true">&#x203A;</span>
                        </button>
                    </li>
                }
            </ul>
        }

        <h2 class="section-title">
            @(Manager.Adapter.CanScan ? "Nearby" : "Paired")
            @if (Manager.IsScanning)
            {
                <span class="spinner small" aria-label="Scanning"></span>
            }
        </h2>

        var nearby = Manager.Discovered.Where(d => Manager.GetConnected(d.Id) == null).ToList();
        @if (nearby.Count == 0)
        {
            <p class="empty-state small">
                @(Manager.Adapter.CanScan ? "Looking for pucks, AmiiboLinks and AmiLoops..." : "Use \"Pair a Device\" to choose a puck, AmiiboLink or AmiLoop.")
            </p>
        }
        else
        {
            <ul class="list">
                @foreach (var device in nearby)
                {
                    var guess = TagDeviceDetector.GuessKind(device);
                    <li class="list-row-split">
                        <button type="button" class="list-row" @onclick="() => Connect(device, null)">
                            <span class="list-row-title">
                                @device.DisplayName
                                <span class="list-row-subtitle">@(guess == TagDeviceKind.Unknown ? "Will detect on connect" : TagDeviceDetector.Describe(guess))@(device.Rssi != 0 ? $" · {device.Rssi} dBm" : "")</span>
                            </span>
                        </button>
                        <button type="button" class="link-button" @onclick="() => ConnectAs(device)">Connect as...</button>
                    </li>
                }
            </ul>
        }

        @if (Manager.Adapter.CanScan)
        {
            <label class="toggle-row">
                <input type="checkbox" checked="@Manager.ShowAllDevices" @onchange="ToggleShowAll" />
                <span>Show all Bluetooth devices</span>
            </label>
        }
    }
</AppPage>

@code {
    private string? _problem;
    private bool _startedScan;

    protected override async Task OnInitializedAsync()
    {
        Manager.Changed += OnChanged;
        if (Manager.Adapter.IsAvailable)
        {
            _startedScan = !Manager.IsScanning;
            _problem = await Manager.StartScanningAsync();
        }
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void ToggleShowAll(ChangeEventArgs e) => Manager.ShowAllDevices = e.Value is true;

    private async Task RequestDevice()
    {
        try
        {
            var device = await Manager.RequestDeviceAsync();
            if (device != null)
            {
                await Connect(device, null);
            }
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Bluetooth", ex.Message);
        }
    }

    private async Task ConnectAs(BleDeviceInfo device)
    {
        TagDeviceKind[] kinds = [TagDeviceKind.Puck, TagDeviceKind.LegacyPuck, TagDeviceKind.AmiiboLink, TagDeviceKind.AmiLoop];
        var choice = await Dialogs.ChooseAsync($"Connect to {device.DisplayName} as", kinds.Select(TagDeviceDetector.Describe).ToList());
        if (choice >= 0)
        {
            await Connect(device, kinds[choice]);
        }
    }

    private async Task Connect(BleDeviceInfo device, TagDeviceKind? kind)
    {
        using var cts = new CancellationTokenSource();
        var dialog = Dialogs.ShowProgress("Please Wait", $"Connecting to {device.DisplayName}...", cts);
        ITagDevice? connected = null;
        try
        {
            var status = new Progress<string>(message => dialog.Update(message));
            connected = await Manager.ConnectAsync(device, kind, status, cts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            await dialog.DisposeAsync();
            await Dialogs.AlertAsync("Couldn't connect", ex.Message);
        }
        finally
        {
            await dialog.DisposeAsync();
        }

        if (connected != null)
        {
            await OpenDevice(connected);
        }
    }

    private Task OpenDevice(ITagDevice device) => Navigator.NavigateAsync(AppRoutes.Device(device.Info.Id, device.Name));

    public async ValueTask DisposeAsync()
    {
        Manager.Changed -= OnChanged;
        if (_startedScan)
        {
            await Manager.StopScanningAsync();
        }
    }
}
