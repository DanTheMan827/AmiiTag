<?xml version="1.0" encoding="utf-8"?>
<!--
  Android: a debug APK (not an AAB) signed with the debug keystore, like the one Visual Studio installs when you run
  the app on a device, but complete enough to sideload anywhere (adb install, or copy it to the phone).

    dotnet publish AmiiTag.Maui -f net10.0-android -c Debug -p:PublishProfile=android-debug-apk

  The APK ends up in AmiiTag.Maui\bin\publish\android-debug\ as com.companyname.amiitag.maui-Signed.apk.
  Being signed with the same debug key, it installs over (and can be replaced by) a build run from Visual Studio.
-->
<Project>
  <PropertyGroup>
    <Configuration>Debug</Configuration>
    <PublishDir>bin\publish\android-debug\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- An APK only: a Release publish would make an AAB as well, which can't be sideloaded. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidPackageFormats>apk</AndroidPackageFormats>

    <!--
      The debug keystore (%LOCALAPPDATA%\Xamarin\Mono for Android\debug.keystore, or ~/.local/share/Xamarin/Mono for
      Android/debug.keystore), the one every debug build is signed with. No release keystore is used.
    -->
    <AndroidKeyStore>false</AndroidKeyStore>

    <!--
      Debug builds normally leave the app's assemblies out of the APK and push them to the device separately (fast
      deployment), so a debug APK on its own crashes at start. They go inside it here.
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Every common ABI, so it runs on phones (arm64, older arm) and emulators (x64). -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>

    <!-- Blazor and the BLE/NFC libraries use reflection; no trimming or AOT for a debug build. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
</Project>
