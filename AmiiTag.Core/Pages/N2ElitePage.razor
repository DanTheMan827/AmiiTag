@page "/n2elite"
@implements IDisposable
@inject N2EliteService N2
@inject TagActions Actions
@inject AmiiboLookup Lookup
@inject IDatabaseContainer DatabaseContainer
@inject IDialogService Dialogs
@inject IAppNavigator Navigator
@inject IFileService Files
@inject ContextMenus Menus

@* The gear (native bar in the apps, header on the web) opens the N2's options, like the device screens. *@
<AppPage OnRefresh="Refresh" OnSettings="ShowOptions" Title="N2 Elite" Wide="true">
    <ChildContent>
        @* Opened by Manage N2 Elite once an N2 has been scanned; with none (a bookmark, or after locking) it closes. *@
        @if (N2.Info is { } info)
        {
            @if (info.IsSingleTagEmulator)
            {
                <p class="notice">This is a Pixl.js answering as an N2 Elite. It holds a single tag, so it's shown as one bank; use Manage Devices to reach its files over Bluetooth.</p>
            }

            <div class="n2-summary">
                <div class="n2-stat">
                    <span class="n2-stat-value">@(info.ActiveBank + 1)</span>
                    <span class="n2-stat-label">Active bank</span>
                </div>
                <div class="n2-stat">
                    <span class="n2-stat-value">@info.UsableBanks</span>
                    <span class="n2-stat-label">Banks enabled</span>
                </div>
                <div class="n2-stat">
                    <span class="n2-stat-value">@N2.Banks.Count(b => !b.IsEmpty)</span>
                    <span class="n2-stat-label">In use</span>
                </div>
                <div class="n2-stat wide">
                    <span class="n2-stat-value mono">@(string.IsNullOrEmpty(info.IdHex) ? "Unknown" : info.IdHex)</span>
                    <span class="n2-stat-label">Device ID@(info.FirmwareVersion is int fw ? $" · firmware {fw}" : "")</span>
                </div>
            </div>

            <ul class="list grid">
                @foreach (var bank in N2.Banks)
                {
                    var active = bank.Bank == info.ActiveBank;
                    var title = BankTitle(bank);
                    var items = BankItems(bank);
                    <li>
                        <button type="button" class="list-row with-image @(bank.IsEmpty ? "dimmed" : "") @(active ? "n2-active" : "")"
                                @onpointerdown="Menus.TrackPointer"
                                @onclick="e => Menus.ClickAsync(e, title, items)"
                                @oncontextmenu="e => Menus.ShowAsync(e, title, items)" @oncontextmenu:preventDefault="true">
                            @if (bank.IsEmpty)
                            {
                                <span class="list-row-image n2-empty-image" aria-hidden="true">@(bank.Bank + 1)</span>
                            }
                            else
                            {
                                <FigureImage Figure="Lookup.GetSlotFigure(bank.Summary)" Class="list-row-image" />
                            }
                            <span class="list-row-title">
                                @(bank.IsEmpty ? "Empty bank" : Lookup.GetSlotDisplayName(bank.Summary))
                                <span class="list-row-subtitle">Bank @(bank.Bank + 1)@(active ? " · Active" : "")</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>

            <div class="button-stack compact">
                <BigButton OnClick="Refresh" Class="secondary">Refresh</BigButton>
            </div>
        }
    </ChildContent>
</AppPage>

<FigurePicker Open="_pickerOpen"
              Title="@($"Write to Bank {_pickerBank + 1}")"
              Filter="IsNtag215Figure"
              OnPicked="WriteCharacter"
              OnCancelled="() => _pickerOpen = false" />

@code {
    private bool _pickerOpen;
    private int _pickerBank;

    private bool _closing;

    protected override void OnInitialized()
    {
        N2.Changed += OnN2Changed;
        DatabaseContainer.DataChanged += OnChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender ? CloseIfNoN2Async() : Task.CompletedTask;

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void OnN2Changed(object? sender, EventArgs e) => InvokeAsync(async () =>
    {
        StateHasChanged();
        await CloseIfNoN2Async();
    });

    // Scanning (and unlocking) happens from the main menu's Manage N2 Elite.
    private async Task CloseIfNoN2Async()
    {
        if (N2.Info == null && !_closing)
        {
            _closing = true;
            await Navigator.GoHomeAsync();
        }
    }

    private Task Refresh() => N2.RefreshAsync();


    private static bool IsNtag215Figure(AmiiboFigure figure) => figure.Id.Id.EndsWith("02", StringComparison.Ordinal);

    private string BankTitle(N2EliteBank bank) => $"Bank {bank.Bank + 1}: {(bank.IsEmpty ? "Empty" : Lookup.GetSlotDisplayName(bank.Summary))}";

    /// <summary>
    /// A bank's actions: Open (when it holds a tag) is what a click does on desktop; the rest are in its context menu.
    /// </summary>
    private IReadOnlyList<ContextMenuItem> BankItems(N2EliteBank bank)
    {
        var items = new List<ContextMenuItem>();
        if (!bank.IsEmpty)
        {
            items.Add(new("Open", async () =>
            {
                var dump = await N2.ReadBankAsync(bank.Bank);
                if (dump != null)
                {
                    await Actions.OpenTagAsync(dump, modal: false);
                }
            }, IsDefault: true));
        }

        if (bank.Bank != N2.Info?.ActiveBank)
        {
            items.Add(new("Make active", () => N2.SelectBankAsync(bank.Bank)));
        }

        if (!bank.IsEmpty)
        {
            items.Add(new("Save backup", async () =>
            {
                var dump = await N2.ReadBankAsync(bank.Bank);
                if (dump != null)
                {
                    await Actions.SaveTagAsync(dump);
                }
            }));
        }

        items.Add(new("Write tag file here", () => WriteFile(bank.Bank)));
        items.Add(new("Write character here", () =>
        {
            _pickerBank = bank.Bank;
            _pickerOpen = true;
            return Task.CompletedTask;
        }));

        if (!bank.IsEmpty)
        {
            items.Add(new("Wipe bank", async () =>
            {
                if (await Dialogs.ConfirmAsync("Wipe bank?", $"Bank {bank.Bank + 1} will be erased.", "Wipe", "Cancel"))
                {
                    await N2.WipeBankAsync(bank.Bank);
                }
            }, IsDestructive: true));
        }

        return items;
    }

    private async Task WriteFile(int bank)
    {
        var file = await Files.PickFileAsync($"Write to Bank {bank + 1}", TagActions.TagFileExtensions);
        if (file == null)
        {
            return;
        }

        if (!TagDump.TryCreate(file.Data, out var dump) || dump == null)
        {
            await Dialogs.AlertAsync("Invalid file", $"{file.Name} isn't an NTAG215 dump. The N2 Elite only holds NTAG215 amiibo.");
            return;
        }

        await N2.WriteBankAsync(bank, dump);
    }

    private async Task WriteCharacter(AmiiboFigure figure)
    {
        _pickerOpen = false;
        var bank = _pickerBank;

        IAmiiboImage? image;
        try
        {
            image = await Actions.CreateFromFigureAsync(figure);
        }
        catch (Exception ex)
        {
            await Dialogs.AlertAsync("Couldn't create the tag", ex.Message);
            return;
        }

        if (image == null)
        {
            if (await Dialogs.ConfirmAsync("Keys needed", "Generating a tag needs both amiibo keys. Load them in Settings?", "Settings", "Cancel"))
            {
                await Navigator.NavigateAsync(AppRoutes.Settings());
            }

            return;
        }

        if (image is TagDump dump)
        {
            await N2.WriteBankAsync(bank, dump);
        }
    }

    private async Task ShowOptions()
    {
        var info = N2.Info;
        var options = new List<(string Title, Func<Task> Run)>
        {
            ("Refresh", () => N2.RefreshAsync()),
        };

        if (info is { IsSingleTagEmulator: false })
        {
            options.Add(("Set bank count", SetBankCount));
            options.Add(("Back up all banks", () => N2.BackupAllAsync()));
            options.Add(("Wipe all banks", new Func<Task>(async () =>
            {

                if (await Dialogs.ConfirmAsync(
                                        "Wipe all banks?",
                                        "All banks will be erased and the bank count will be set to 1.",
                                        "Wipe", "Cancel"))
                {
                    await N2.WipeBanksAfterAsync(-1);
                    await N2.SelectBankAsync(0);
                }
            })));
            
            options.Add(("Lock N2 Elite", async () =>
            {
                if (await Dialogs.ConfirmAsync(
                        "Lock N2 Elite?",
                        "A locked N2 works like a single normal amiibo and can't be managed until it's unlocked by holding its button.",
                        "Lock", "Cancel"))
                {
                    await N2.LockAsync();
                }
            }));
        }
        else if (info != null)
        {
            options.Add(("Back up", () => N2.BackupAllAsync()));
        }

        var choice = await Dialogs.ChooseAsync("N2 Elite", options.Select(o => o.Title).ToList());
        if (choice >= 0)
        {
            await options[choice].Run();
        }
    }

    private async Task SetBankCount()
    {
        var current = N2.Info?.BankCount ?? 1;
        var text = await Dialogs.PromptAsync("Bank Count", $"How many banks to enable (1-{N2EliteClient.MaxBanks})? Banks past the count keep their data.", current.ToString(), 3);
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        if (!int.TryParse(text.Trim(), out var count) || count is < 1 or > N2EliteClient.MaxBanks)
        {
            await Dialogs.AlertAsync("Invalid bank count", $"Enter a number from 1 to {N2EliteClient.MaxBanks}.");
            return;
        }

        await N2.SetBankCountAsync(count);
    }

    public void Dispose()
    {
        N2.Changed -= OnN2Changed;
        DatabaseContainer.DataChanged -= OnChanged;
    }
}
