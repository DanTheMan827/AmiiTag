@page "/"
@using AmiiTag.Core.Interfaces;
@using System.Security.Cryptography;
@using AmiiTag.Core.Bootstrap;

<PageTitle>AmiiTag</PageTitle>
<AppLogo Style="max-width: 500px;" />
<BootstrapButton Style="BootstrapButton.ButtonKind.Danger">Test</BootstrapButton>

<h1>Hello, world!</h1>

Welcome to your new app.


@if (StatusMessage != null)
{
    <p><b>Status:</b> @StatusMessage</p>
}

<p>Base path @AppPaths.BaseAddress</p>
<p>Running on @ApplicationEnvironment.Platform</p>

@code {
    private string? StatusMessage = null;

    private async Task TestInterop() {
        if (await AmiiboDatabase.CheckUpdate() == true)
        {
            await AmiiboDatabase.UpdateData(UpdateProgress);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await TestInterop();
        await base.OnInitializedAsync();
    }

    private async Task UpdateProgress(ProgressInfo info)
    {
        StatusMessage = $"({info.Current} / {info.Total}: {info.Message})";

        StateHasChanged();
    }
}
